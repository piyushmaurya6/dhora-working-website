{%- if section.settings.products != blank or section.blocks.size > 0 -%}
  {%- assign has_products = true -%}
{%- else -%}
  {%- assign has_products = false -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} .manual-grid-wrapper {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 0.5rem !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .manual-grid-wrapper {
      gap: 1.25rem !important;
    }
  }

  #shopify-section-{{ section.id }} .manual-grid-wrapper product-card,
  #shopify-section-{{ section.id }} .manual-grid-wrapper .product-card {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    flex: 0 1 auto !important;
    margin: 0 !important;
    box-sizing: border-box !important;
  }

  #shopify-section-{{ section.id }} .manual-grid-wrapper .product-card__figure,
  #shopify-section-{{ section.id }} .manual-grid-wrapper .product-card__media {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    display: block !important;
    box-sizing: border-box !important;
  }

  #shopify-section-{{ section.id }} .manual-grid-wrapper svg,
  #shopify-section-{{ section.id }} .manual-grid-wrapper img {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    display: block !important;
    object-fit: contain !important;
  }

  #shopify-section-{{ section.id }} .manual-grid-wrapper .product-card__info {
    width: 100% !important;
    min-width: 0 !important;
    text-align: center !important;
    box-sizing: border-box !important;
  }

  #shopify-section-{{ section.id }} .manual-slider__heading {
    letter-spacing: 0.18em;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .manual-grid-wrapper {
      gap: 0.35rem !important;
    }
    #shopify-section-{{ section.id }} .product-card__info {
      padding-top: 0.35rem !important;
    }
    #shopify-section-{{ section.id }} .product-title {
      font-size: 0.65rem !important;
      line-height: 1.15 !important;
      word-break: break-word !important;
    }
    #shopify-section-{{ section.id }} .price-list {
      font-size: 0.65rem !important;
    }
  }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container">
    <div class="section-stack">
      {%- if section.settings.title != blank or section.settings.subheading != blank -%}
        <div class="v-stack justify-self-center gap-2 text-center">
          {%- if section.settings.subheading != blank -%}
            <p class="h6 text-center">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="h5 manual-slider__heading text-center">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="manual-grid-wrapper">
        {%- if section.settings.products != blank -%}
          {%- for product in section.settings.products limit: 3 -%}
            {%- render 'product-card', product: product, reveal: true, position: forloop.index, show_vendor: section.settings.show_vendor, hide_product_information: section.settings.hide_product_information -%}
          {%- endfor -%}
        {%- elsif section.blocks.size > 0 -%}
          {%- for block in section.blocks limit: 3 -%}
            {%- if block.settings.product != blank -%}
              {%- render 'product-card', product: block.settings.product, reveal: true, position: forloop.index, show_vendor: section.settings.show_vendor, hide_product_information: section.settings.hide_product_information, block: block -%}
            {%- else -%}
              {%- render 'product-card-placeholder', reveal: true, loop_index: forloop.index0, show_vendor: section.settings.show_vendor, hide_product_information: section.settings.hide_product_information -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            {%- render 'product-card-placeholder', reveal: true, loop_index: forloop.index0, show_vendor: section.settings.show_vendor, hide_product_information: section.settings.hide_product_information -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Manual Product Grid (3 Items)",
  "class": "shopify-section--manual-product-slider",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "Separate section with border",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 3
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "Hide product information",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manual Product Grid (3 Items)",
      "settings": {
        "title": "RECOMMENDED"
      },
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
