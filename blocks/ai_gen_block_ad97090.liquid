{% doc %}
  @prompt
    Create a section for the product page that displays exactly 3 landscape images side by side in a single row with zero gap between them. Each image should have a 4:3 aspect ratio (wider than tall, landscape/horizontal orientation). Each of the 3 blocks has its own independent image upload setting. The design must be ultra minimal and clean — no text, no padding, no borders, no background, just 3 equal landscape images flush against each other filling the full width of the screen. Inspired by Saint Laurent website style where 3 small product flatlay images appear in a tight horizontal row beneath a large model photo.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-triple-landscape-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .ai-triple-landscape-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .ai-triple-landscape-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 75%;
    overflow: hidden;
    margin: 0;
  }

  .ai-triple-landscape-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-triple-landscape-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-triple-landscape-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }
{% endstyle %}

<div class="ai-triple-landscape-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-triple-landscape-grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
      %}
      <div class="ai-triple-landscape-item-{{ ai_gen_id }}">
        {% if image %}
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
            class="ai-triple-landscape-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-triple-landscape-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Triple landscape images",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    }
  ],
  "presets": [
    {
      "name": "Triple landscape images"
    }
  ]
}
{% endschema %}
