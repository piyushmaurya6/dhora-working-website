{%- if section.settings.products != blank or section.blocks.size > 0 -%}
  {%- assign has_products = true -%}
{%- else -%}
  {%- assign has_products = false -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} .custom-grid-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    width: 100%;
    margin: 0 auto;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .custom-grid-wrapper {
      gap: 2rem;
      max-width: 1200px; /* Optional: constrain width on large screens */
    }
  }

  #shopify-section-{{ section.id }} .custom-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    text-align: center;
    align-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .custom-card-image {
    width: 100%;
    aspect-ratio: 1 / 1; /* Square aspect ratio to keep them uniform */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .custom-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Ensures the whole product is visible */
  }

  #shopify-section-{{ section.id }} .placeholder-svg {
    width: 100%;
    height: 100%;
    background-color: transparent;
    fill: currentColor;
    opacity: 0.5;
  }

  #shopify-section-{{ section.id }} .custom-card-info {
    margin-top: 0.75rem;
    width: 100%;
    padding: 0 0.25rem;
  }

  #shopify-section-{{ section.id }} .custom-card-vendor {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .custom-card-title {
    font-family: var(--text-font-family);
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .custom-card-price {
    font-family: var(--text-font-family);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .manual-slider__heading {
    letter-spacing: 0.18em;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  /* Specific mobile tweaks to guarantee they fit */
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .custom-grid-wrapper {
      gap: 0.25rem; /* Very tight gap so they fit */
    }
    #shopify-section-{{ section.id }} .custom-card-info {
      margin-top: 0.5rem;
      padding: 0;
    }
    #shopify-section-{{ section.id }} .custom-card-title,
    #shopify-section-{{ section.id }} .custom-card-price {
      font-size: 0.6rem; /* Small text for mobile */
    }
    #shopify-section-{{ section.id }} .custom-card-vendor {
      font-size: 0.5rem;
    }
  }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container">
    <div class="section-stack">
      {%- if section.settings.title != blank or section.settings.subheading != blank -%}
        <div class="v-stack justify-self-center gap-2 text-center">
          {%- if section.settings.subheading != blank -%}
            <p class="h6 text-center">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="h5 manual-slider__heading text-center">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="custom-grid-wrapper">
        {%- if section.settings.products != blank -%}
          {%- for product in section.settings.products limit: 3 -%}
            <a href="{{ product.url }}" class="custom-card">
              <div class="custom-card-image">
                {%- if product.featured_media -%}
                  <img src="{{ product.featured_media | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- unless section.settings.hide_product_information -%}
                <div class="custom-card-info">
                  {%- if section.settings.show_vendor -%}
                    <div class="custom-card-vendor">{{ product.vendor }}</div>
                  {%- endif -%}
                  <div class="custom-card-title">{{ product.title }}</div>
                  <div class="custom-card-price">{{ product.price | money }}</div>
                </div>
              {%- endunless -%}
            </a>
          {%- endfor -%}
        {%- elsif section.blocks.size > 0 -%}
          {%- for block in section.blocks limit: 3 -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              <a href="{{ product.url }}" class="custom-card" {{ block.shopify_attributes }}>
                <div class="custom-card-image">
                  {%- if product.featured_media -%}
                    <img src="{{ product.featured_media | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                {%- unless section.settings.hide_product_information -%}
                  <div class="custom-card-info">
                    {%- if section.settings.show_vendor -%}
                      <div class="custom-card-vendor">{{ product.vendor }}</div>
                    {%- endif -%}
                    <div class="custom-card-title">{{ product.title }}</div>
                    <div class="custom-card-price">{{ product.price | money }}</div>
                  </div>
                {%- endunless -%}
              </a>
            {%- else -%}
              {%- assign placeholder_idx = forloop.index | modulo: 6 | plus: 1 -%}
              <div class="custom-card" {{ block.shopify_attributes }}>
                <div class="custom-card-image">
                  {{ 'product-' | append: placeholder_idx | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                {%- unless section.settings.hide_product_information -%}
                  <div class="custom-card-info">
                    {%- if section.settings.show_vendor -%}
                      <div class="custom-card-vendor">Vendor</div>
                    {%- endif -%}
                    <div class="custom-card-title">Product</div>
                    <div class="custom-card-price">{{ 4999 | money }}</div>
                  </div>
                {%- endunless -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            {%- assign placeholder_idx = i -%}
            <div class="custom-card">
              <div class="custom-card-image">
                {{ 'product-' | append: placeholder_idx | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              {%- unless section.settings.hide_product_information -%}
                <div class="custom-card-info">
                  {%- if section.settings.show_vendor -%}
                    <div class="custom-card-vendor">Vendor</div>
                  {%- endif -%}
                  <div class="custom-card-title">Product</div>
                  <div class="custom-card-price">{{ 4999 | money }}</div>
                </div>
              {%- endunless -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Manual Product Grid (3 Items)",
  "class": "shopify-section--manual-product-grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "Separate section with border",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 3
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "Hide product information",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manual Product Grid (3 Items)",
      "settings": {
        "title": "RECOMMENDED"
      },
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
